# equipment-tplink settings. Copy to .env and edit.
# Precedence: process environment > --env-file > ./.env > defaults.
# Empty values count as unset.

# TP-Link / Kasa account. Needed by the cloud driver; also passed to python-kasa
# for plugs that require local credentials (KLAP). Leave empty for local-only use.
TPLINK_USERNAME=
TPLINK_PASSWORD=

# Bind address and port of the REST service.
EQUIPMENT_TPLINK_HOST=0.0.0.0
EQUIPMENT_TPLINK_PORT=8080

# Python log level. Each request logs one JSON line at INFO.
EQUIPMENT_TPLINK_LOG_LEVEL=INFO

# LAN discovery broadcast address and duration (seconds). Use the subnet broadcast
# (e.g. 192.168.1.255) on hosts with more than one network interface.
EQUIPMENT_TPLINK_DISCOVERY_TARGET=255.255.255.255
EQUIPMENT_TPLINK_DISCOVERY_TIMEOUT_S=5

# Default per-call timeouts (seconds); requests can override with ?timeout_s=.
EQUIPMENT_TPLINK_LOCAL_TIMEOUT_S=10
EQUIPMENT_TPLINK_CLOUD_TIMEOUT_S=20

# Wait (milliseconds) before the verify read after a relay command.
EQUIPMENT_TPLINK_RELAY_SETTLE_MS=500

# Hardware tests only (make hardware); ignored by the service.
# TEST_PLUG_MAC=00:00:5E:00:53:01
# TEST_LOCAL=1
# TEST_ALLOW_FACTORY_RESET=1
